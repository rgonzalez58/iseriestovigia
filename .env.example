# ORIGEN_DRIVER=iSeries Access ODBC Driver
# ORIGEN_SISTEMA=<host o IP del iSeries>
# ORIGEN_OPCIONES=NAM=1;DBQ=GNBWEB_DB
ORIGEN_USUARIO=
ORIGEN_PASSWORD=
DESTINO_DRIVER=ODBC Driver 17 for SQL Server
DESTINO_SERVIDOR=
DESTINO_BASE=vigia
DESTINO_USUARIO=
DESTINO_PASSWORD=
